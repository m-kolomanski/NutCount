{
  "name": "nutcount",
  "version": "1.0.0",
  "description": "Application for tracking nutritional intake",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "start": "electron .",
    "build:react": "vite build",
    "dev": "vite --port 3000",
    "dev:electron": "concurrently \"npm run dev\" \"wait-on http://localhost:3000 && cross-env NODE_ENV=development electron .\"",
    "build": "vite build",
    "preview": "vite preview",
    "build:win": "npm run build && electron-builder --win",
    "test:build": "npm run build && electron .",
    "test": "vitest run"
  },
  "keywords": [
    "electron",
    "react"
  ],
  "author": "Mateusz Kołomański",
  "license": "MIT",
  "build": {
    "appId": "com.mateusz.nutcount",
    "productName": "NutCount",
    "directories": {
      "output": "dist"
    },
    "files": [
      "dist-react/**/*",
      "main.js",
      "package.json",
      "node_modules/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "src/assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.3",
    "@eslint/js": "^9.39.2",
    "@vitejs/plugin-react": "^5.1.4",
    "@vitest/ui": "^4.0.18",
    "concurrently": "^9.2.1",
    "cross-env": "^10.0.0",
    "electron": "^40.4.1",
    "electron-builder": "^26.0.12",
    "eslint": "^9.39.2",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^17.3.0",
    "sass": "^1.97.3",
    "vite": "^6.0.7",
    "vitest": "^4.0.18",
    "wait-on": "^9.0.4"
  },
  "dependencies": {
    "better-sqlite3": "^12.2.0",
    "bootstrap": "^5.3.3",
    "bootstrap-icons": "^1.11.3",
    "electron-log": "^5.4.3",
    "i18next": "^25.8.10",
    "js-yaml": "^4.1.0",
    "react": "^18.3.1",
    "react-bootstrap": "^2.10.5",
    "react-dom": "^18.3.1",
    "react-i18next": "^16.5.4",
    "react-router-bootstrap": "^0.26.3",
    "react-router-dom": "^6.30.0",
    "react-select": "^5.10.2"
  }
}
